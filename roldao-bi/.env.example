# Identidade exibida no BI (cabeçalho, rodapé e título da aba).
# Lidas no build — depois de alterar, refaça o build.
NEXT_PUBLIC_BI_EMPRESA="Prima Atacadista"
NEXT_PUBLIC_BI_PRODUTO="BI de Performance Comercial"

# Armazenamento. Com as duas variáveis do Netlify preenchidas, o BI usa o
# Netlify Blobs; sem elas, grava em disco (padrão: ./.data).
# NETLIFY_BLOBS_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
# BI_DATA_DIR=./.data
