POSTGRES_DB=delivery_db
POSTGRES_USER=delivery_user
POSTGRES_PASSWORD=delivery_pass

# Obrigatório: mínimo de 32 caracteres aleatórios (gere com: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Obrigatório em produção: origens autorizadas do frontend, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Chaves para notificações push (gere seu próprio par com: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
